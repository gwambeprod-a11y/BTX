{
  "appId": "cm.batix.app",
  "appName": "BATIX",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Camera": {
      "presentationStyle": "fullscreen",
      "saveToGallery": false
    },
    "Geolocation": {
      "enableHighAccuracy": true
    }
  }
}
